# Hermes chat server (installed by deploy/install.sh, PLAN.md section 18.4).
# Config: /etc/hermes/hermes.toml   Data: /var/lib/hermes   Logs: journalctl -u hermes

[Unit]
Description=Hermes chat server
Documentation=https://github.com/senko-tools/hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/var/lib/hermes
ExecStart=/usr/local/bin/hermes-server run --config /etc/hermes/hermes.toml
# Reloads the TLS certificate (tls.mode = "files"); other config changes need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# The server closes connections and exits within 10 s of SIGTERM.
TimeoutStopSec=20

# Lets network.port be set below 1024 if wanted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ReadWritePaths=/var/lib/hermes
ReadOnlyPaths=/etc/hermes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
