# Release image (built by .github/workflows/release.yml): the static musl binaries built by the
# workflow, copied per architecture, so the multi-arch image needs no emulated compiling.
# Build context: bin/amd64/hermes-server, bin/arm64/hermes-server, an empty data/ directory.
# To build the image from source instead, use deploy/docker/Dockerfile.

FROM gcr.io/distroless/static-debian12
ARG TARGETARCH
COPY --chmod=755 bin/${TARGETARCH}/hermes-server /hermes-server
COPY --chown=10001:10001 data /data
USER 10001:10001
WORKDIR /data
# Config comes from HERMES__… variables; a /data/hermes.toml is used too if present.
ENV HERMES_CONFIG=/data/hermes.toml \
    HERMES__STORAGE__DATA_DIR=/data
EXPOSE 7700/tcp 7700/udp
VOLUME /data
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["/hermes-server", "healthcheck"]
ENTRYPOINT ["/hermes-server", "run"]
